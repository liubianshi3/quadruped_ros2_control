<?xml version="1.0"?>
<!--
  Dog2 Symmetric Robot Description (Xacro Root)
  Fully symmetric variant for IK/WBC/MPC simulation.
  Differs from dog2.urdf.xacro:
    - Leg mounts: strictly symmetric about base_link center
    - Trunk: clean primitive box centered at base_link origin
    - Base_link inertial: origin at (0,0,0), rpy=(0,0,0), pure-diagonal inertia in base_link frame
    - rf hip_xyz: 0.016 (mirrored from lh), not 0.0116
    - leg_knee_xyz_R z: -0.0274 (matches left knee magnitude)
    - leg4 shin/foot: identical to leg3
  Reuses dog2_leg_macro.xacro and dog2_ros2_control.xacro unchanged.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dog2_symmetric">

  <xacro:arg name="controllers_yaml" default="$(find dog2_description)/config/ros2_controllers.yaml"/>
  <xacro:arg name="robot_param_node" default="robot_state_publisher"/>
  <!-- Instrumentation only: adds Gazebo contact sensors without changing links,
       joints, geometry, inertia, limits, or ros2_control interfaces. -->
  <xacro:arg name="enable_acceptance_contact_sensors" default="false"/>
  <xacro:property name="controllers_yaml" value="$(arg controllers_yaml)"/>
  <xacro:property name="robot_param_node" value="$(arg robot_param_node)"/>

  <!-- Shared constants and tiny helper macros. -->
  <xacro:include filename="$(find dog2_description)/urdf/dog2_symmetric_properties.xacro"/>
  <!-- Leg visual/collision meshes: symmetric variants generated by Blender. -->
  <xacro:property name="dog2_mesh_root" value="package://dog2_description/meshes_symmetric"/>
  <xacro:property name="dog2_collision_mesh_root" value="package://dog2_description/meshes_symmetric/collision"/>

  <!-- Trunk: clean primitive box centered at base_link origin.
       base_link is the URDF / ROS / control / Pinocchio root frame.
       Inertia is pure-diagonal (no cross coupling) directly in base_link. -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="6.0"/>
      <inertia ixx="0.0153" ixy="0" ixz="0" iyy="0.044" iyz="0" izz="0.052"/>
    </inertial>
    <collision>
      <origin xyz="${trunk_collision_box_xyz}" rpy="0 0 0"/>
      <geometry>
        <box size="${trunk_collision_box_size}"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="${trunk_collision_box_xyz}" rpy="0 0 0"/>
      <geometry>
        <box size="${trunk_collision_box_size}"/>
      </geometry>
      <material name="mat_base_gray">
        <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1"/>
      </material>
    </visual>
  </link>

  <xacro:if value="$(arg enable_acceptance_contact_sensors)">
    <gazebo reference="base_link">
      <sensor name="base_acceptance_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <contact>
          <collision>base_link_collision</collision>
          <topic>/dog2/gz_contact/base</topic>
        </contact>
      </sensor>
    </gazebo>
  </xacro:if>

  <!-- Leg topology macro. -->
  <xacro:include filename="$(find dog2_description)/urdf/dog2_leg_macro.xacro"/>

  <!-- Leg instantiations — strictly symmetric mount positions.
       absolute CAD coords: lf=(0.12685,0.0625) lh=(0.3711,0.0625)
                            rh=(0.3711,0.1825)   rf=(0.12685,0.1825)
       base_link-local: ±0.122125 X, ±0.060000 Y -->
  <link name="lf_leg_mount">
    <xacro:frame_inertial/>
  </link>
  <joint name="lf_leg_mount_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="lf_leg_mount"/>
    <origin xyz="-0.122125 -0.060000 0" rpy="${leg_rail_rpy_L}"/>
  </joint>

  <link name="lh_leg_mount">
    <xacro:frame_inertial/>
  </link>
  <joint name="lh_leg_mount_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="lh_leg_mount"/>
    <origin xyz="0.122125 -0.060000 0" rpy="${leg_rail_rpy_L}"/>
  </joint>

  <link name="rh_leg_mount">
    <xacro:frame_inertial/>
  </link>
  <joint name="rh_leg_mount_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="rh_leg_mount"/>
    <origin xyz="0.122125 0.060000 0" rpy="${leg_rail_rpy_R}"/>
  </joint>

  <link name="rf_leg_mount">
    <xacro:frame_inertial/>
  </link>
  <joint name="rf_leg_mount_fixed" type="fixed">
    <parent link="base_link"/>
    <child link="rf_leg_mount"/>
    <origin xyz="-0.122125 0.060000 0" rpy="${leg_rail_rpy_R}"/>
  </joint>

  <xacro:leg prefix="lf" side="left" leg_num="1" parent_link="lf_leg_mount" rail_axis="${leg_rail_axis_L}" p_low="0.0" p_up="0.111"
             thigh_xyz="${leg12_thigh_xyz}" shin_xyz="${leg12_shin_xyz}" slider_inertia_xyz="${l1_inertia_xyz}"
             foot_tip_xyz="${leg12_foot_tip_xyz}"
             use_primitive_links="true"
             femur_primitive_xyz="${femur_primitive_xyz}" femur_primitive_rpy="${femur_primitive_rpy}"
             femur_primitive_length="${femur_primitive_length}" femur_primitive_radius="${femur_primitive_radius}"
             femur_primitive_ixx="${femur_primitive_ixx}" femur_primitive_iyy="${femur_primitive_iyy}" femur_primitive_izz="${femur_primitive_izz}"
             tibia_primitive_xyz="${tibia_left_primitive_xyz}" tibia_primitive_rpy="${tibia_left_primitive_rpy}"
             tibia_primitive_length="${tibia_left_primitive_length}" tibia_primitive_radius="${tibia_left_primitive_radius}"
             tibia_primitive_ixx="${tibia_left_primitive_ixx}" tibia_primitive_iyy="${tibia_left_primitive_iyy}" tibia_primitive_izz="${tibia_left_primitive_izz}"
             enable_acceptance_contact_sensors="$(arg enable_acceptance_contact_sensors)"/>

  <xacro:leg prefix="lh" side="left" leg_num="2" parent_link="lh_leg_mount" rail_axis="${leg_rail_axis_L}" p_low="-0.111" p_up="0.0"
             thigh_xyz="${leg12_thigh_xyz}" shin_xyz="${leg12_shin_xyz}" slider_inertia_xyz="${l2_inertia_xyz}"
             hip_xyz="0.016 0.0199 0.055"
             foot_tip_xyz="${leg12_foot_tip_xyz}"
             use_primitive_links="true"
             femur_primitive_xyz="${femur_primitive_xyz}" femur_primitive_rpy="${femur_primitive_rpy}"
             femur_primitive_length="${femur_primitive_length}" femur_primitive_radius="${femur_primitive_radius}"
             femur_primitive_ixx="${femur_primitive_ixx}" femur_primitive_iyy="${femur_primitive_iyy}" femur_primitive_izz="${femur_primitive_izz}"
             tibia_primitive_xyz="${tibia_left_primitive_xyz}" tibia_primitive_rpy="${tibia_left_primitive_rpy}"
             tibia_primitive_length="${tibia_left_primitive_length}" tibia_primitive_radius="${tibia_left_primitive_radius}"
             tibia_primitive_ixx="${tibia_left_primitive_ixx}" tibia_primitive_iyy="${tibia_left_primitive_iyy}" tibia_primitive_izz="${tibia_left_primitive_izz}"
             enable_acceptance_contact_sensors="$(arg enable_acceptance_contact_sensors)"/>

  <xacro:leg prefix="rh" side="right" leg_num="3" parent_link="rh_leg_mount" rail_axis="${leg_rail_axis_R}" p_low="-0.111" p_up="0.0"
             thigh_xyz="${leg3_thigh_xyz}" shin_xyz="${leg3_shin_xyz}" slider_inertia_xyz="${l3_inertia_xyz}"
             knee_xyz="${leg_knee_xyz_R}"
             foot_tip_xyz="${leg3_foot_tip_xyz}"
             use_primitive_links="true"
             femur_primitive_xyz="${femur_primitive_xyz}" femur_primitive_rpy="${femur_primitive_rpy}"
             femur_primitive_length="${femur_primitive_length}" femur_primitive_radius="${femur_primitive_radius}"
             femur_primitive_ixx="${femur_primitive_ixx}" femur_primitive_iyy="${femur_primitive_iyy}" femur_primitive_izz="${femur_primitive_izz}"
             tibia_primitive_xyz="${tibia_right_primitive_xyz}" tibia_primitive_rpy="${tibia_right_primitive_rpy}"
             tibia_primitive_length="${tibia_right_primitive_length}" tibia_primitive_radius="${tibia_right_primitive_radius}"
             tibia_primitive_ixx="${tibia_right_primitive_ixx}" tibia_primitive_iyy="${tibia_right_primitive_iyy}" tibia_primitive_izz="${tibia_right_primitive_izz}"
             enable_acceptance_contact_sensors="$(arg enable_acceptance_contact_sensors)"/>

  <!-- Front-right: symmetric hip offset (mirrors lh), symmetric knee Z, symmetric shin/foot -->
  <xacro:leg prefix="rf" side="right" leg_num="4" parent_link="rf_leg_mount" rail_axis="${leg_rail_axis_R}" p_low="0.0" p_up="0.111"
             thigh_xyz="${leg4_thigh_xyz}" shin_xyz="${leg4_shin_xyz}" slider_inertia_xyz="${l4_inertia_xyz}"
             hip_xyz="0.016 0.0199 0.055" knee_xyz="${leg_knee_xyz_R}"
             foot_tip_xyz="${leg4_foot_tip_xyz}"
             use_primitive_links="true"
             femur_primitive_xyz="${femur_primitive_xyz}" femur_primitive_rpy="${femur_primitive_rpy}"
             femur_primitive_length="${femur_primitive_length}" femur_primitive_radius="${femur_primitive_radius}"
             femur_primitive_ixx="${femur_primitive_ixx}" femur_primitive_iyy="${femur_primitive_iyy}" femur_primitive_izz="${femur_primitive_izz}"
             tibia_primitive_xyz="${tibia_right_primitive_xyz}" tibia_primitive_rpy="${tibia_right_primitive_rpy}"
             tibia_primitive_length="${tibia_right_primitive_length}" tibia_primitive_radius="${tibia_right_primitive_radius}"
             tibia_primitive_ixx="${tibia_right_primitive_ixx}" tibia_primitive_iyy="${tibia_right_primitive_iyy}" tibia_primitive_izz="${tibia_right_primitive_izz}"
             enable_acceptance_contact_sensors="$(arg enable_acceptance_contact_sensors)"/>

  <xacro:include filename="$(find dog2_description)/urdf/dog2_ros2_control.xacro"/>
  <xacro:dog2_ros2_control controllers_yaml="${controllers_yaml}" robot_param_node="${robot_param_node}"/>

</robot>
